  "story": {
    "title": "归还灯心",
    "synopsis": "查明古灯熄灭的原因，找到守灯人与灯心，按证据记录的步骤重新点亮古灯。",
    "player_role": "来到灰苇村的冒险者",
    "opening": "深秋雨夜，你推开歪角鹿酒馆的门。吧台挂着守灯人失踪的告示，村长在壁炉旁踱步。梅瑞尔把热麦酒推到你面前：“也是为告示来的？”",
    "start_location": 0,
    "starting_item": "防水札记",
    "acts": [
      "在酒馆与山脚核实失踪经过，自行决定先向谁询问。",
      "读懂铭文，进入千灯廊，辨认灯心和守灯人的线索。",
      "抵达合唱厅后选择是否依据已核实步骤归还灯心；玩家不必接受村长的安排。"
    ],
    "clues": [
      {
        "title": "巡山日志",
        "text": "伊索德最后一页记着：灯灭后应沿千灯廊追查灯心，归来路上不要随合唱走向侧门。",
