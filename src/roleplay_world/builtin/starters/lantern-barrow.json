  "adaptation": {
    "scope": "中文探索冒险改编；保留主要人物与灯灭事件，增加可操作的补给、装备、同行、战斗和三个原作任务方向。",
    "retained": [
      "六名具名人物、灰苇村与古冢、灯灭与守灯人失踪",
      "围绕灯心与守灯人展开的隐藏线索",
      "原作短剑、药水、麻绳、火把和干粮，以及寻找守灯人、消失的灯心、地下歌声三条任务方向",
      "古冢警戒、喧闹/交战/久留与安静/重燃壁灯之间的因果方向，以及名望面板"
    ],
    "adapted": [
      "村长家与磨坊合并到村庄场景；深层墓室归并为合唱厅",
      "新增可调查证据与归还仪式步骤，使短篇在类型化状态规则内闭环",
      "原作银币映射为通用规则货币；治疗、补给和战斗数值改用本项目d20轻规则",
      "雷恩与布兰诺克可经本人同意同行；同行不会代替玩家选择，也不单独参加战斗",
      "新增守冢残影作为可绕开的轻战斗，以及村民开放避雨棚的自主世界事件",
      "1.2以声明式变量与明确行动实现警戒0至6、交战/休息加警戒、安静绕行/重燃壁灯减警戒、警戒满时苏醒，以及安眠仪式清零和一次名望奖励；每个行动与触发器均有可执行验收路线"
    ],
    "unsupported": [
      "六属性配点、队友独立战斗、火把自动燃尽、黑暗视野及古冢之王交易仍未移植",
      "警戒是有界改编：未对自由文本中的破门、喧哗或火光逐句判定；古冢苏醒没有创建独立之王战斗或交易角色",
      "原作多结局没有全部等价复刻；补给、战斗和警戒数值为本项目改编"
    ]
  },
  "world": {
    "title": "灰苇村与提灯古冢",
    "genre": "奇幻探索",
    "tone": "温暖村落与克制的幽暗",
    "premise": "守护村庄百年的古灯熄灭，失踪的守灯人仍未归来。",
    "setting": "灰苇村在沼泽边，歪角鹿酒馆、磨坊和小礼拜堂维系居民生活。村北的提灯古冢每夜亮灯；最近灯灭、羊失踪，地下传来歌声。村长以三十枚银币悬赏寻找守灯人；确认守灯人生还并标出归路，可领取三十单位规则货币；一笔赏金只结算一次。",
