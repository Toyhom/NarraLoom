    "cues": [
      {
        "start": 0,
        "end": 12,
        "text": "A reference workspace for creators, players and developers.",
        "key": "workspace"
      },
      {
        "start": 12,
        "end": 24,
        "text": "Five sections keep worlds, saves, community, avatars and transfers together.",
        "key": "navigation"
      },
      {
        "start": 24,
        "end": 36,
        "text": "Choose a local or API model using OpenAI, Responses or Anthropic protocols.",
        "key": "connection"
      },
      {
        "start": 36,
        "end": 48,
        "text": "Adjust structured output, temperature compatibility and context budget.",
        "key": "parameters"
      },
      {
        "start": 48,
        "end": 60,
        "text": "Test the saved connection with an actual model request. Waiting is shortened.",
        "key": "diagnose"
      },
      {
        "start": 60,
        "end": 72,
        "text": "Read the returned result before creating a world.",
        "key": "connected"
      },
      {
        "start": 72,
        "end": 84,
        "text": "Describe a world and its first story. Choose scale and content language.",
        "key": "idea"
      },
      {
        "start": 84,
        "end": 96,
        "text": "Optionally bind a prepared 2D NPC. This portrait came from an imported package.",
        "key": "avatar"
      },
      {
        "start": 96,
        "end": 108,
        "text": "The engine creates content and automatically playtests it. Waiting is shortened.",
        "key": "generate"
      },
      {
        "start": 108,
        "end": 124,
        "text": "Each tested revision reports structure, mechanics, model play and content review.",
        "key": "quality"
      },
      {
        "start": 124,
        "end": 136,
        "text": "Edit, retest, request AI text repair or export a native story.",
        "key": "storytools"
      },
      {
        "start": 136,
        "end": 148,
        "text": "World settings and stories are separate versioned objects.",
        "key": "worldedit"
      },
      {
        "start": 148,
        "end": 160,
        "text": "Inspect places and their connections in the location editor.",
        "key": "locations"
      },
      {
        "start": 160,
        "end": 172,
        "text": "Edit NPC personality, goals, knowledge and optional portrait bindings.",
        "key": "characters"
      },
      {
        "start": 172,
        "end": 184,
        "text": "Story overview, acts, clues, challenges and systems have their own tabs.",
        "key": "storyedit"
      },
      {
        "start": 184,
        "end": 196,
        "text": "Create another story in the same world from a new idea.",
        "key": "second"
      },
      {
        "start": 196,
        "end": 211,
        "text": "Both stories use the same world and retain their own test reports.",
        "key": "twostories"
      },
      {
        "start": 211,
        "end": 223,
        "text": "Start a tested story with your own player character.",
        "key": "start"
      },
      {
        "start": 223,
        "end": 235,
        "text": "Write a natural-language action or dialogue. Model waiting is shortened.",
        "key": "speak"
      },
      {
        "start": 235,
        "end": 255,
        "text": "The 2D NPC performs committed dialogue with expression and motion.",
        "key": "reply"
      },
      {
        "start": 255,
        "end": 271,
        "text": "Read narration and state effects together after the action commits.",
        "key": "outcome"
      },
      {
        "start": 271,
        "end": 283,
        "text": "Record a personal note or commitment without advancing world time.",
        "key": "notes"
      },
      {
        "start": 283,
        "end": 295,
        "text": "Search known memories and inspect their source records.",
        "key": "memory"
      },
      {
        "start": 295,
        "end": 307,
        "text": "Fork at an earlier turn to explore another direction.",
        "key": "branch"
      },
      {
        "start": 307,
        "end": 319,
        "text": "Branches retain their own events and memories.",
        "key": "branches"
      },
      {
        "start": 319,
        "end": 335,
        "text": "This imported revision failed content review. Inspect the reported claim before repair.",
        "key": "import-review"
      },
      {
        "start": 335,
        "end": 351,
        "text": "AI text repair creates a new revision and reruns the automatic checks.",
        "key": "import-repaired"
      },
      {
        "start": 351,
        "end": 363,
        "text": "An imported RPG example adds equipment, commerce and combat rules.",
        "key": "rulesedit"
      },
      {
        "start": 363,
        "end": 375,
        "text": "Inspect structured item and rule definitions in the world editor.",
        "key": "rulesdetail"
      },
      {
        "start": 375,
        "end": 390,
        "text": "The Actions tab exposes legal operations and current resources.",
        "key": "ruleplay"
      },
      {
        "start": 390,
        "end": 402,
        "text": "Select a rule action directly; the engine validates its preconditions.",
        "key": "ruleaction"
      },
      {
        "start": 402,
        "end": 417,
        "text": "Committed rule changes and narration remain in the same event history.",
        "key": "ruleresult"
      },
      {
        "start": 417,
        "end": 429,
        "text": "Open the map when you need routes and world context.",
        "key": "map"
      },
      {
        "start": 429,
        "end": 445,
        "text": "A living-world example tracks offscreen characters and faction progress.",
        "key": "livingworld"
      },
      {
        "start": 445,
        "end": 457,
        "text": "Pause or resume world simulation from the player interface.",
        "key": "pauseworld"
      },
      {
        "start": 457,
        "end": 473,
        "text": "Buy from a shop: inventory and coins change together in one committed action.",
        "key": "buy"
      },
      {
        "start": 473,
        "end": 489,
        "text": "Follow connected map routes to reach the encounter.",
        "key": "travel"
      },
      {
        "start": 489,
        "end": 505,
        "text": "Choose an attack and let the configured rule system resolve combat.",
        "key": "combat"
      },
      {
        "start": 505,
        "end": 521,
        "text": "Inspect the recorded dice, modifier, threshold and outcome. Replay keeps this result.",
        "key": "dice"
      },
      {
        "start": 521,
        "end": 537,
        "text": "Define variables, visibility, conditions, actions, triggers and authored test routes.",
        "key": "stateedit"
      },
      {
        "start": 537,
        "end": 552,
        "text": "Only player-visible values and available actions appear in the game view.",
        "key": "stateplay"
      },
      {
        "start": 552,
        "end": 564,
        "text": "Create a shared-character or independent-character multiplayer room.",
        "key": "room"
      },
      {
        "start": 564,
        "end": 580,
        "text": "A second browser joins as Alex with an independent character.",
        "key": "members"
      },
      {
        "start": 580,
        "end": 596,
        "text": "Room tools group player views, notes, character control and trades.",
        "key": "roomtools"
      },
      {
        "start": 596,
        "end": 608,
        "text": "The host submits a conversation in the shared room. Model waiting is shortened.",
        "key": "roomaction"
      },
      {
        "start": 608,
        "end": 624,
        "text": "Room narration reflects the committed world version and participating characters.",
        "key": "roomresult"
      },
      {
        "start": 624,
        "end": 636,
        "text": "Choose a previous campaign as continuity for the next story.",
        "key": "continuity"
      },
      {
        "start": 636,
        "end": 648,
        "text": "Package tested stories with creator credit, license and optional 2D assets.",
        "key": "package"
      },
      {
        "start": 648,
        "end": 660,
        "text": "Download a portable native package from your community shelf.",
        "key": "download"
      },
      {
        "start": 660,
        "end": 672,
        "text": "Inspect included stories before installing and automatically testing a copy.",
        "key": "import"
      },
      {
        "start": 672,
        "end": 684,
        "text": "Export the full campaign, including its branches and event history.",
        "key": "backup"
      },
      {
        "start": 684,
        "end": 696,
        "text": "Preview a backup before restoring it as an independent adventure.",
        "key": "restore"
      },
      {
        "start": 696,
        "end": 708,
        "text": "Install the exported package as an editable copy. Waiting for testing is shortened.",
        "key": "install"
      },
      {
        "start": 708,
        "end": 724,
        "text": "The copied world and both stories have their own automatic test results.",
        "key": "installed"
      },
      {
        "start": 724,
        "end": 736,
        "text": "Restore the validated backup into a new campaign.",
        "key": "restore-run"
      },
      {
        "start": 736,
        "end": 752,
        "text": "The restored campaign keeps its branches and committed history.",
        "key": "restored"
      },
      {
        "start": 752,
        "end": 764,
        "text": "Assign a provider and model separately for each engine module.",
        "key": "modules"
      },
      {
        "start": 764,
        "end": 776,
        "text": "Module descriptions explain which model abilities each task needs.",
        "key": "modelguidance"
      },
      {
        "start": 776,
        "end": 788,
        "text": "Configuration example: a System One decision model in shadow mode; unsaved.",
        "key": "decision"
      },
      {
        "start": 788,
        "end": 800,
        "text": "Configuration example: a separate embedding model for hybrid memory; unsaved.",
        "key": "embedding"
      },
      {
        "start": 800,
        "end": 812,
        "text": "Inspect calls, reported tokens and optional price estimates by model.",
        "key": "usage"
      },
      {
        "start": 812,
        "end": 832,
        "text": "Actual SDK result: access the same world library without the reference UI.",
        "key": "sdk"
      },
      {
        "start": 832,
        "end": 852,
        "text": "Executed fixture example: custom action modules, replay, forks and restoration.",
        "key": "extension"
      },
      {
        "start": 852,
        "end": 872,
        "text": "Actual model evaluation: frozen tasks, assertions, latency and token accounting.",
        "key": "evaluation"
      },
      {
        "start": 872,
        "end": 892,
        "text": "Executed fixture example: checkpointed trajectories, resume and recall checks.",
        "key": "playtest"
      },
      {
        "start": 892,
        "end": 907,
        "text": "Switch the interface language while authored world and story text stays intact.",
        "key": "languages"
      },
      {
        "start": 907,
        "end": 921,
        "text": "Build with the backend, SDK, reference UI and guides at github.com/Toyhom/NarraLoom.",
        "key": "finish"
      }
    ]
  },
