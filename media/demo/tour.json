      {
        "start": 0,
        "end": 12,
        "text": "从参考工作台进入创作、游玩与开发。",
        "key": "workspace"
      },
      {
        "start": 12,
        "end": 24,
        "text": "五个入口分别管理世界、存档、社区、角色资产和导入恢复。",
        "key": "navigation"
      },
      {
        "start": 24,
        "end": 36,
        "text": "选择本地或 API 模型，支持 OpenAI、Responses 和 Anthropic 协议。",
        "key": "connection"
      },
      {
        "start": 36,
        "end": 48,
        "text": "按模型能力调整结构化输出、温度兼容性和上下文预算。",
        "key": "parameters"
      },
      {
        "start": 48,
        "end": 60,
        "text": "真实调用模型测试已保存的连接；视频压缩了等待时间。",
        "key": "diagnose"
      },
      {
        "start": 60,
        "end": 72,
        "text": "确认模型实际返回的测试结果，再开始创建世界。",
        "key": "connected"
      },
      {
        "start": 72,
        "end": 84,
        "text": "输入世界构想与首个故事，选择创作规模和内容语言。",
        "key": "idea"
      },
      {
        "start": 84,
        "end": 96,
        "text": "初始 NPC 可绑定已有 2D 形象；这里复用了导入包中的成品资产。",
        "key": "avatar"
      },
      {
        "start": 96,
        "end": 108,
        "text": "引擎生成内容并自动试跑，等待时间已压缩。",
        "key": "generate"
      },
      {
        "start": 108,
        "end": 124,
        "text": "每个版本都有结构、规则、真实模型试跑与内容审核结果。",
        "key": "quality"
      },
      {
        "start": 124,
        "end": 136,
        "text": "在故事工具中编辑、重测、请求 AI 文本修订或导出原生故事。",
        "key": "storytools"
      },
      {
        "start": 136,
        "end": 148,
        "text": "世界设定与故事分别管理版本，同一世界可以容纳多个故事。",
        "key": "worldedit"
      },
      {
        "start": 148,
        "end": 160,
        "text": "在地点编辑页查看场景及其相互连接。",
        "key": "locations"
      },
      {
        "start": 160,
        "end": 172,
        "text": "人物页集中编辑 NPC 性格、目标、秘密和可选的形象绑定。",
        "key": "characters"
      },
      {
        "start": 172,
        "end": 184,
        "text": "故事编辑器按概览、剧本、线索、挑战和机制分组。",
        "key": "storyedit"
      },
      {
        "start": 184,
        "end": 196,
        "text": "输入新的构想，在同一世界中自动创建另一个故事。",
        "key": "second"
      },
      {
        "start": 196,
        "end": 211,
        "text": "两个故事共享世界，各自保留独立的测试报告。",
        "key": "twostories"
      },
      {
        "start": 211,
        "end": 223,
        "text": "选择通过测试的故事，以自己的角色进入世界。",
        "key": "start"
      },
      {
        "start": 223,
        "end": 235,
        "text": "用自然语言表达行动或对话；模型等待时间已压缩。",
        "key": "speak"
      },
      {
        "start": 235,
        "end": 255,
        "text": "2D NPC 根据已提交的对话呈现表情与动作。",
        "key": "reply"
      },
      {
        "start": 255,
        "end": 271,
        "text": "行动提交后，一起查看叙事结果与状态变化。",
        "key": "outcome"
      },
      {
        "start": 271,
        "end": 283,
        "text": "记录个人手记或约定，不推进世界时间。",
        "key": "notes"
      },
      {
        "start": 283,
        "end": 295,
        "text": "检索已知记忆，并查看记忆来源。",
        "key": "memory"
      },
      {
        "start": 295,
        "end": 307,
        "text": "从指定回合创建故事分支，探索另一种走向。",
        "key": "branch"
      },
      {
        "start": 307,
        "end": 319,
        "text": "每条分支分别保留自己的事件与记忆。",
        "key": "branches"
      },
      {
        "start": 319,
        "end": 335,
        "text": "这个导入版本未通过内容审核，先查看指出的文本问题。",
        "key": "import-review"
      },
      {
        "start": 335,
        "end": 351,
        "text": "AI 文本修订创建新版本，并重新执行自动检查。",
        "key": "import-repaired"
      },
      {
        "start": 351,
        "end": 363,
        "text": "导入的跑团示例包含装备、交易与战斗规则。",
        "key": "rulesedit"
      },
      {
        "start": 363,
        "end": 375,
        "text": "在世界编辑器中查看结构化的道具与规则定义。",
        "key": "rulesdetail"
      },
      {
        "start": 375,
        "end": 390,
        "text": "操作页展示当前可执行的规则动作和角色资源。",
        "key": "ruleplay"
      },
      {
        "start": 390,
        "end": 402,
        "text": "直接选择规则动作，由引擎验证执行条件。",
        "key": "ruleaction"
      },
      {
        "start": 402,
        "end": 417,
        "text": "规则变化与叙述一起记录在已提交的事件历史中。",
        "key": "ruleresult"
      },
      {
        "start": 417,
        "end": 429,
        "text": "需要查看路线和世界状态时，再展开地图。",
        "key": "map"
      },
      {
        "start": 429,
        "end": 445,
        "text": "主动世界示例跟踪离场人物和势力进展。",
        "key": "livingworld"
      },
      {
        "start": 445,
        "end": 457,
        "text": "玩家可从界面暂停或恢复世界模拟。",
        "key": "pauseworld"
      },
      {
        "start": 457,
        "end": 473,
        "text": "从商店购买物品：背包与金币在同一次行动中同步结算。",
        "key": "buy"
      },
      {
        "start": 473,
        "end": 489,
        "text": "沿地图中的相连路线移动，抵达遭遇地点。",
        "key": "travel"
      },
      {
        "start": 489,
        "end": 505,
        "text": "选择攻击，由配置的规则系统结算战斗。",
        "key": "combat"
      },
      {
        "start": 505,
        "end": 521,
        "text": "查看已记录的骰值、修正、阈值和结果；回放保留原来的结算。",
        "key": "dice"
      },
      {
        "start": 521,
        "end": 537,
        "text": "这个导入版本未通过内容审核，先查看指出的文本问题。",
        "key": "import-review"
      },
      {
        "start": 537,
        "end": 553,
        "text": "AI 文本修订创建新版本，并重新执行自动检查。",
        "key": "import-repaired"
      },
      {
        "start": 553,
        "end": 569,
        "text": "自定义状态支持变量、可见性、条件、动作、触发器和自动验收路线。",
        "key": "stateedit"
      },
      {
        "start": 569,
        "end": 584,
        "text": "游玩界面只显示玩家可见的状态值与当前可用动作。",
        "key": "stateplay"
      },
      {
        "start": 584,
        "end": 596,
        "text": "创建共享角色或独立角色的多人房间。",
        "key": "room"
      },
      {
        "start": 596,
        "end": 612,
        "text": "另一浏览器以 Alex 加入，并拥有独立角色。",
        "key": "members"
      },
      {
        "start": 612,
        "end": 628,
        "text": "房间工具集中管理玩家视角、手记、角色控制与交易。",
        "key": "roomtools"
      },
      {
        "start": 628,
        "end": 640,
        "text": "房主在房间内提交一段对话，模型等待已压缩。",
        "key": "roomaction"
      },
      {
        "start": 640,
        "end": 656,
        "text": "房间叙事对应已提交的世界版本与参与角色。",
        "key": "roomresult"
      },
      {
        "start": 656,
        "end": 668,
        "text": "新故事可选择继承先前冒险的连续经历。",
        "key": "continuity"
      },
      {
        "start": 668,
        "end": 680,
        "text": "把已测试的故事、署名、许可和可选 2D 资产打成创作包。",
        "key": "package"
      },
      {
        "start": 680,
        "end": 692,
        "text": "从自己的社区作品架下载可携带的原生创作包。",
        "key": "download"
      },
