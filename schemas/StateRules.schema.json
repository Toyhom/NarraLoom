{
  "$defs": {
    "StateAction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 400,
          "title": "Description",
          "type": "string"
        },
        "location_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_-]{1,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Id"
        },
        "when_all": {
          "items": {
            "$ref": "#/$defs/StateCondition"
          },
          "maxItems": 12,
          "title": "When All",
          "type": "array"
        },
        "when_any": {
          "items": {
            "$ref": "#/$defs/StateCondition"
          },
          "maxItems": 12,
          "title": "When Any",
          "type": "array"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/StateEffect"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Effects",
          "type": "array"
        },
        "once": {
          "default": false,
          "title": "Once",
          "type": "boolean"
        },
        "cooldown_s": {
          "default": 0,
          "maximum": 86400,
          "minimum": 0,
          "title": "Cooldown S",
          "type": "integer"
        },
        "time_cost_s": {
          "default": 60,
          "maximum": 1800,
          "minimum": 1,
          "title": "Time Cost S",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "effects"
      ],
      "title": "StateAction",
      "type": "object"
    },
    "StateCondition": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "variable",
            "resource",
            "item_count",
            "location",
            "knowledge",
            "quest",
            "clock",
            "party",
            "game_time"
          ],
          "title": "Source",
          "type": "string"
        },
        "key": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_-]{1,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key"
        },
        "actor_id": {
          "default": "pc_traveler",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Actor Id",
          "type": "string"
        },
        "op": {
          "default": "eq",
          "enum": [
            "eq",
            "ne",
            "ge",
            "gt",
            "le",
            "lt"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "maxLength": 80,
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "source",
        "value"
      ],
      "title": "StateCondition",
      "type": "object"
    },
    "StateEffect": {
      "additionalProperties": false,
