        "actor_id": {
          "default": "pc_traveler",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "title": "Actor Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "maxLength": 80,
              "type": "string"
            }
