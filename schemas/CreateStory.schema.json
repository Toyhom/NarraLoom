{
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9_-]{1,80}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "content_language": {
      "anyOf": [
        {
          "maxLength": 35,
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8}){0,3}$",
          "type": "string"
        },
        {
          "const": "auto",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Language"
    },
    "creation_preset": {
      "anyOf": [
        {
          "enum": [
            "scene",
            "story",
            "adventure"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Creation Preset"
    },
    "prompt": {
      "maxLength": 2500,
      "minLength": 5,
      "title": "Prompt",
      "type": "string"
    },
    "custom_states": {
      "default": false,
      "title": "Custom States",
      "type": "boolean"
    }
  },
  "required": [
    "prompt"
  ],
  "title": "CreateStory",
  "type": "object"
}
