        "when_any": {
          "items": {
            "$ref": "#/$defs/StateCondition"
          },
          "maxItems": 12,
          "title": "When Any",
          "type": "array"
        },
        "effects": {
          "items": {
            "$ref": "#/$defs/StateEffect"
