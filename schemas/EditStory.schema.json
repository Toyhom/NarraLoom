        "description": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "location": {
          "maximum": 63,
          "minimum": 0,
          "title": "Location",
          "type": "integer"
        },
        "required_clues": {
          "items": {
            "maximum": 63,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 16,
          "title": "Required Clues",
          "type": "array"
        },
        "skill": {
          "default": "none",
          "enum": [
            "observation",
            "persuasion",
            "agility",
            "craft",
            "none"
          ],
