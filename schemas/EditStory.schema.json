          "type": "string"
        },
        "difficulty": {
          "default": 8,
          "maximum": 100,
          "minimum": 1,
          "title": "Difficulty",
          "type": "integer"
        },
        "success": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Success",
          "type": "string"
        },
        "ending": {
          "default": false,
          "title": "Ending",
          "type": "boolean"
        },
        "reward_coins": {
          "default": 0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Reward Coins",
          "type": "integer"
        },
        "reward_xp": {
          "default": 0,
          "maximum": 1000,
          "minimum": 0,
          "title": "Reward Xp",
          "type": "integer"
        }
      },
      "required": [
        "title",
        "description",
        "location",
        "success"
      ],
      "title": "Challenge",
      "type": "object"
    },
    "Clue": {
      "additionalProperties": false,
      "properties": {
