        "cooldown_s": {
          "default": 0,
          "maximum": 86400,
          "minimum": 0,
          "title": "Cooldown S",
          "type": "integer"
        },
        "time_cost_s": {
          "default": 60,
          "maximum": 1800,
          "minimum": 1,
          "title": "Time Cost S",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "effects"
      ],
      "title": "StateAction",
      "type": "object"
