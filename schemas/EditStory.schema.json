          "type": "string"
        },
        "location_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_-]{1,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Id"
        },
        "when_all": {
          "items": {
            "$ref": "#/$defs/StateCondition"
          },
          "maxItems": 12,
          "title": "When All",
          "type": "array"
