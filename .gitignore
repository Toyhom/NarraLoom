*.gguf
*.onnx
*.pt
*.pth
*.ckpt
*.wav
*.mp4
*.zip

# Reviewed upstream scenario data is public source material, not runtime state.
!resources/community/covel/worlds/*/data/
!resources/community/covel/worlds/*/data/**

# Optional generated Avatar packages
characters/
